<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gestion Location Voiture - @ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TP01.styles.css" asp-append-version="true" />
</head>
@{
        var theme = Context.Request.Cookies["Theme"] ?? "light";
}
<body data-bs-theme="@theme">
    <header>
        <nav class="navbar navbar-expand-sm border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Succursale" asp-action="List">
                    <i class="bi bi-car-front-fill"></i> Gestion Location Voiture
                </a>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.IsInRole("ADMINISTRATEUR"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Succursale" asp-action="List">
                                    Succursales
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Utilisateur" asp-action="List">
                                    Utilisateurs
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("ADMINISTRATEUR") || User.IsInRole("GERANT") || User.IsInRole("COMMIS"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Location" asp-action="List">
                                    Locations
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Conducteur" asp-action="List">
                                    Conducteurs
                                </a>
                            </li>
                        }
                    </ul>
                    @if (User.Identity!.IsAuthenticated)
                    {
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <span class="nav-link text-muted">
                                    @User.Identity.Name
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-danger" asp-controller="Auth" asp-action="Logout">
                                    Se déconnecter
                                </a>
                            </li>
                        </ul>
                    }
                    <form method="get" action="/Theme/Set">
                        <input type="hidden" name="theme" value="@(theme == "dark" ? "light" : "dark")" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                        <button type="submit" class="btn">
                            <i class="bi bi-@(theme == "dark" ? "sun" : "moon")"></i>
                        </button>
                    </form>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - TP01
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>