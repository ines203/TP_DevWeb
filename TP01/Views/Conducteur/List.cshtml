@model IEnumerable<SystemeDeLocation.Website.Models.Conducteur.List>
@{
    ViewData["Title"] = "Liste des conducteurs";
}

<h1>Liste des conducteurs</h1>

@if (TempData["Erreur"] != null)
{
    <div class="alert alert-danger">@TempData["Erreur"]</div>
}

@if (!Model.Any())
{
    <p>Aucun conducteur.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Prénom</th>
                <th>Nom</th>
                <th>Date de location</th>
                <th>Voiture louée</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var conducteur in Model)
            {
                @if (conducteur.FermeturePlanifiee > DateTime.Now)
                {
                    <tr>
                        <td>@conducteur.Prenom</td>
                        <td>@conducteur.Nom</td>
                        <td>@conducteur.Ouverture.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@conducteur.Surnom</td>
                        <td>
                            <a asp-action="Profil" asp-route-id="@conducteur.ConducteurId"
                               class="btn btn-sm btn-outline-primary">Profil</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
}