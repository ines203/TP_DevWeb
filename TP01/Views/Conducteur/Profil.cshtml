@model TP01.Models.Conducteur.Profil
@{
    ViewData["Title"] = "Profil du conducteur";
}

<h1>@Model.Prenom @Model.Nom</h1>

@if (TempData["Erreur"] != null)
{
    <div class="alert alert-danger">@TempData["Erreur"]</div>
}

<div class="card mb-4">
    <div class="card-header"><strong>Informations personnelles</strong></div>
    <div class="card-body">
        <p><strong>Prénom :</strong> @Model.Prenom</p>
        <p><strong>Nom :</strong> @Model.Nom</p>
        <p><strong>Téléphone :</strong> @Model.NumeroDeTelephone</p>
        <p><strong>Courriel :</strong> @Model.AdresseCourriel</p>
        <p><strong>No. permis :</strong> @Model.NumeroDuPermis</p>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header"><strong>Adresse</strong></div>
    <div class="card-body">
        @{
            var adresse = Model.NumeroCivic + " " + Model.Rue + ", " + Model.Ville + ", " + Model.CodePostal;
        }
        @if (Model.NumeroCivic == null)
        {
            <p>Aucune adresse.</p>
        }
        else
        {
            <p>@adresse</p>
            <a href="https://www.google.com/maps/search/?api=1&query=@adresse.Replace(' ', '+')" class="btn btn-sm btn-success" target="_blank">Ouvrir dans Google Maps</a>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header"><strong>Location associée</strong></div>
    <div class="card-body">
        @if (Model.FermeturePlanifiee < DateTime.Now)
        {
            <p>Aucune location associée.</p>
        }
        else
        {
            <p><strong>Voiture :</strong> @Model.Surnom</p>
            <p><strong>Ouverture :</strong> @Model.Ouverture.ToString("yyyy-MM-dd HH:mm")</p>
            <p><strong>Fermeture planifiée :</strong> @Model.FermeturePlanifiee.ToString("yyyy-MM-dd HH:mm")</p>
            <p><strong>Statut :</strong> @Model.Statut</p>
            <a asp-controller="Location" asp-action="Details"
               asp-route-id="@Model.locationId" class="btn btn-sm btn-outline-primary">
                Voir la location
            </a>
        }
    </div>
</div>

<a asp-action="List" class="btn btn-outline-secondary">← Retour aux conducteurs</a>
