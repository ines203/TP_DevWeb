@model TP01.Models.Auth.AuthModel
@{
    ViewData["Title"] = "Connexion";
}

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">
        @ViewBag.ErrorMessage
    </div>
}
<div class="login-form">
    <h2>Se connecter</h2>
    <form asp-action="Login" method="post">
        <div>
            <label asp-for="NomUtilisateur" class="form-label">Nom d'utilisateur</label>
            <input asp-for="NomUtilisateur" class="form-control" />
            <span asp-validation-for="NomUtilisateur" class="text-danger"></span>
        </div>
        <br>
        <div>
            <label asp-for="MotDePasse"></label>
            <input asp-for="MotDePasse" type="password" class="form-control" />
            <span asp-validation-for="MotDePasse" class="text-danger"></span>
        </div>
        <br>
        <button type="submit" class="btn btn-primary">Se connecter</button>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}