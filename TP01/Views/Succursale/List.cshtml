@model IEnumerable<SystemeDeLocation.Website.Models.Succursale.SuccursaleList>
@{
    ViewData["Title"] = "Liste des succursales";
    bool estAdministrateur = User.IsInRole("ADMINISTRATEUR");
    bool estUtilisateur = !User.IsInRole("ADMINISTRATEUR") && !User.IsInRole("GERANT") && !User.IsInRole("COMMIS");
}
<h1>Liste des succursales</h1>
@await Html.PartialAsync("_Message")
@if (!Model.Any())
{
    <p>Aucune succursale disponible.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Statut</th>
                @if (estAdministrateur)
                {
                    <th>Nombre de voitures disponible</th>
                    <th>Nombre de voitures indisponible</th>
                    <th>Nombre de voitures archiver</th>
                    <th>Action</th>
                }
                @if (!estUtilisateur)
                {
                    <th>Voitures</th>
                }
                <th>Locations</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var succursale in Model)
            {
                <tr>
                    <td>@succursale.Nom</td>
                    <td>
                        @if (succursale.Statut == StatutSuccursale.ACTIVE)
                        {
                            <span class="badge bg-success">ACTIVÉE</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">DESACTIVÉE</span>
                        }
                    </td>
                    @if (estAdministrateur)
                    {
                        <td>@succursale.NbVoitureDispo</td>
                        <td>@succursale.NbVoitureIndispo</td>
                        <td>@succursale.NbVoitureArchiver</td>
                        <td>
                            @{
                                var actionTexte = succursale.Statut == StatutSuccursale.ACTIVE ? "Désactiver" : "Activer";
                            }
                            <form asp-action="ChangementStatue" asp-controller="Succursale" method="post"
                                  style="display:inline"
                                  onsubmit="return confirm('Voulez-vous @actionTexte cette succursale?')">
                                <input type="hidden" name="id" value="@succursale.Id" />
                                <button type="submit" class="btn btn-sm @(succursale.Statut == StatutSuccursale.ACTIVE ? "btn-danger" : "btn-success")">
                                    @actionTexte
                                </button>
                            </form>
                        </td>
                    }
                    @if (!estUtilisateur)
                    {
                        <td>
                            <form asp-controller="Voiture" asp-action="List" method="get">
                                <input type="hidden" name="id" value="@succursale.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">Liste voitures</button>
                            </form>
                        </td>
                    }
                    <td>
                        <form asp-controller="Location" asp-action="List" asp-route-id="@succursale.Id" method="get">
                            <input type="hidden" name="id" value="@succursale.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-primary">Liste locations</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (estAdministrateur)
    {
        <form asp-action="Creation" asp-controller="Succursale" method="post">
            <button type="submit" class="btn btn-primary">Ajouter une succursale</button>
        </form>
    }
}