@model IEnumerable<TP01.Models.Succursale.List>

@{
    ViewData["Title"] = "Liste des succursales";
    var role = Context.Session.GetString("RoleUtilisateur");
    bool estAdministrateur = role == "ADMINISTRATEUR";
    bool estClient = role == "CLIENT";
}

<h1>Liste des succursales</h1>

@if (TempData["Message"] != null)
{
    <script>
        alert('@TempData["Message"]');
    </script>
}

@if (!Model.Any())
{
    <p>Aucune succursale disponible.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Statut</th>
                @if (estAdministrateur)
                {
                    <th>Action</th>
                }
                @if (!estClient)
                {
                    <th>Voitures</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var succursale in Model)
            {
                <tr>
                    <td>@succursale.Nom</td>
                    <td>
                        @if (succursale.Statut == StatutSuccursale.ACTIVE)
                        {
                            <span class="badge bg-success">ACTIVÉ</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">DESACTIVÉ</span>
                        }
                    </td>
                    @if (estAdministrateur)
                    {
                        <td>
                            <form asp-action="changementStatue" asp-controller="Succursale" method="post" style="display:inline">
                                <input type="hidden" name="id" value="@succursale.Id" />
                                <button type="submit" class="btn btn-sm @(succursale.Statut == StatutSuccursale.ACTIVE ? "btn-danger" : "btn-success")">
                                    @(succursale.Statut == StatutSuccursale.ACTIVE ? "Désactiver" : "Activer")
                                </button>
                            </form>
                        </td>
                    }
                    @if (!estClient)
                    {
                        <td>
                            <form asp-controller="Voiture" asp-action="List" method="get">
                                <input type="hidden" name="succursaleId" value="@succursale.Id" />
                                <button type="submit">Liste voitures</button>
                            </form>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}