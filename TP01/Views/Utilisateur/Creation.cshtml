@model SystemeDeLocation.Website.Models.Utilisateur.UtilisateurCreation
@{
    ViewData["Title"] = "Créer un utilisateur";
}

<h1>Créer un utilisateur</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Creation" method="post">
            @if (TempData["Erreur"] != null)
            {
                <div class="alert alert-danger">@TempData["Erreur"]</div>
            }

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="NomUtilisateur" class="form-label"></label>
                <input asp-for="NomUtilisateur" class="form-control" />
                <span asp-validation-for="NomUtilisateur" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Role" class="form-label"></label>
                <select asp-for="Role" class="form-select">
                    <option value="">-- Sélectionner un rôle --</option>
                    @foreach (var role in Model.Roles)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SuccursaleId" class="form-label"></label>
                <select asp-for="SuccursaleId" asp-items="Model.Succursales" class="form-select">
                    <option value="">-- Sélectionner une succursale --</option>
                </select>
                <span asp-validation-for="SuccursaleId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MotDePasse" class="form-label"></label>
                <input asp-for="MotDePasse" type="text" class="form-control" />
                <span asp-validation-for="MotDePasse" class="text-danger"></span>
                <small class="text-muted">Mot de passe généré automatiquement — vous pouvez le modifier.</small>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmationMotDePasse" class="form-label"></label>
                <input asp-for="ConfirmationMotDePasse" type="text" class="form-control" />
                <span asp-validation-for="ConfirmationMotDePasse" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Créer</button>
                <a asp-action="List" class="btn btn-outline-secondary">Annuler</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
