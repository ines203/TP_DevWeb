@model SystemeDeLocation.Website.Models.Utilisateur.UtilisateurModificationMdp

@{
    ViewData["Title"] = "Modification mot de passe";
}

<h1>Modification mot de passe de @Model.NomUtilisateur</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="ModificationMdp" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="MotDePasse" class="control-label"></label>
                <input asp-for="MotDePasse" class="form-control" />
                <span asp-validation-for="MotDePasse" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ConfirmationMotDePasse" class="control-label"></label>
                <input asp-for="ConfirmationMotDePasse" class="form-control" />
                <span asp-validation-for="ConfirmationMotDePasse" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="List">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
