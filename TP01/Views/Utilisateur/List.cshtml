@model IEnumerable<SystemeDeLocation.Website.Models.Utilisateur.UtilisateurList>
@{
    ViewData["Title"] = "Liste des utilisateurs";
}

<h1>Liste des utilisateurs</h1>

@await Html.PartialAsync("_Message")

<a asp-action="Creation" class="btn btn-primary mb-3">
    <i class="bi bi-person-plus"></i> Créer un utilisateur
</a>

@if (!Model.Any())
{
    <p>Aucun utilisateur disponible.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Identifiant unique</th>
                <th>Nom d'utilisateur</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var utilisateur in Model)
            {
                <tr>
                    <td>@utilisateur.Id</td>
                    <td>@utilisateur.NomUtilisateur</td>
                    <td>
                        <div class="d-flex gap-1">
                            <form asp-action="Supprimer" asp-route-id="@utilisateur.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-danger"
                                        onclick="return confirm('Voulez-vous supprimer cet usager?')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                            <a asp-action="ModificationMdp" asp-route-id="@utilisateur.Id"
                               class="btn btn-sm btn-warning">
                                <i class="bi bi-key"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
