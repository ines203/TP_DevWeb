@model IEnumerable<SystemeDeLocation.Website.Models.Voiture.List>

@{
    ViewData["Title"] = "Liste des voitures";
    bool estGerant = User.IsInRole("GERANT") || User.IsInRole("ADMINISTRATEUR");
    bool estCommis = User.IsInRole("COMMIS") || User.IsInRole("GERANT") || User.IsInRole("ADMINISTRATEUR");
}

<h1>Liste des voitures de la succursale : @ViewBag.SuccursaleNom</h1>

@await Html.PartialAsync("_Message")

@if (!Model.Any())
{
    <p>Aucune voiture disponible pour cette succursale.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Surnom</th>
                <th>Immatriculation</th>
                <th>Marque</th>
                <th>Modèle</th>
                <th>Couleur</th>
                <th>Année</th>
                <th>Statut</th>
                <th>Disponible</th>
                <th>Actions</th>
                @if (estGerant)
                {
                    <th>Archiver</th>
                }
                @if (estCommis)
                {
                    <th>Création location</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var voiture in Model)
            {
                <tr>
                    <td>@voiture.Surnom</td>
                    <td>@voiture.NumeroImmatriculation</td>
                    <td>@voiture.Marque</td>
                    <td>@voiture.Modele</td>
                    <td>@voiture.Couleur</td>
                    <td>@voiture.Annee</td>
                    <td>
                        @if (voiture.Statut == StatutVoiture.ACTIVE)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Désactivée</span>
                        }
                    </td>
                    <td>
                        @if (voiture.Disponible)
                        {
                            <span class="badge bg-primary">Disponible</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Indisponible</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Profil" asp-route-id="@voiture.VoitureId"
                           class="btn btn-sm btn-info">Profil</a>

                        @if (estCommis && voiture.Statut == StatutVoiture.ACTIVE && voiture.Disponible)
                        {
                            <form asp-action="Desactiver" method="post" style="display:inline"
                                  onsubmit="return confirm('Voulez-vous désactiver cette voiture?')">
                                <input type="hidden" name="id" value="@voiture.VoitureId" />
                                <button type="submit" class="btn btn-sm btn-danger">Désactiver</button>
                            </form>
                        }

                        @if (estGerant && voiture.Statut == StatutVoiture.DESACTIVE)
                        {
                            <form asp-action="Activer" method="post" style="display:inline"
                                  onsubmit="return confirm('Voulez-vous activer cette voiture?')">
                                <input type="hidden" name="id" value="@voiture.VoitureId" />
                                <button type="submit" class="btn btn-sm btn-success">Activer</button>
                            </form>
                        }
                    </td>
                    @if (estGerant)
                    {
                        <td>
                            @if (voiture.Statut == StatutVoiture.DESACTIVE)
                            {
                                <form asp-action="Archiver" method="post" style="display:inline"
                                      onsubmit="return confirm('Voulez-vous archiver cette voiture?')">
                                    <input type="hidden" name="id" value="@voiture.VoitureId" />
                                    <button type="submit" class="btn btn-sm btn-primary">Archiver</button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-secondary" disabled>Archiver</button>
                            }
                        </td>
                    }
                    @if (estCommis)
                    {
                        <td>
                            @if (voiture.Statut == StatutVoiture.ACTIVE && voiture.Disponible)
                            {
                                <a asp-action="Creation"
                                   asp-controller="Location"
                                   asp-route-id="@voiture.VoitureId"
                                   class="btn btn-sm btn-primary"
                                   onclick="return confirm('Voulez-vous louer cette voiture?')">
                                    Louer
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-secondary" disabled>Louer</button>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

<a asp-controller="Succursale" asp-action="List" class="btn btn-outline-secondary mt-2">
    ← Retour aux succursales
</a>