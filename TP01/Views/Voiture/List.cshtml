@model IEnumerable<TP01.Models.Voiture.List>


@if (TempData["Message"] != null)
{
    <script>
        alert('@TempData["Message"]');
    </script>
}

<h1>Liste des voitures de la succursale</h1>


@if (!Model.Any())
{
    <p>Aucune voiture</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Surnom</th>
                <th>Immatriculation</th>
                <th>Marque</th>
                <th>Modèle</th>
                <th>Couleur</th>
                <th>Année</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var voiture in Model)
            {
                <tr>

                    <th><a asp-controller="Voiture" asp-action="Detail" asp-route-succursaleId="@voiture.SuccursaleId" asp-route-voitureId="@voiture.VoitureId">@voiture.Surnom</a></th>
                    <th>@voiture.NumeroImmatriculation</th>
                    <th>@voiture.Marque</th>
                    <th>@voiture.Modele</th>
                    <th>@voiture.Couleur</th>
                    <th>@voiture.Annee</th>
                </tr>
            }
        </tbody>
    </table>
}