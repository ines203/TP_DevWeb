@model IEnumerable<TP01.Models.Voiture.List>

<h1>Liste des voitures de la succursale</h1>

@if (!Model.Any())
{
    <p>Aucune voiture</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Surnom</th>
                <th>Statut</th>
                <th>Disponibilité</th>
                <th>État</th>
                <th>Marque</th>
                <th>Modèle</th>
                <th>Année</th>
                <th>Couleur</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var voiture in Model)
            {
                <tr>
                    <th>@voiture.Surnom</th>
                    <th>@voiture.Statut</th>
                    <th>@voiture.Disponible</th>
                    <th>@voiture.Etat</th>
                    <th>@voiture.Marque</th>
                    <th>@voiture.Modele</th>
                    <th>@voiture.Annee</th>
                    <th>@voiture.Couleur</th>
                </tr>
            }
        </tbody>
    </table>
}