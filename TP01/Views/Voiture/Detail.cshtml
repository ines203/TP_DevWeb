@model TP01.Models.Voiture.Detail

@{
    var voiture = Model;
}

@if (voiture == null)
{
    <p>Erreur</p>
}
else
{
    <p>Nom Succursale : @Model.nomSuccursale</p>
    <p>Surnom: @Model.Surnom</p>
    <p>Statut: @Model.Statut</p>
    <p>Disponibilité: @Model.Disponible</p>
    <p>État: @Model.Etat</p>
    <p>Num serie: @Model.NumeroDeSerie</p>
    <p>Num Immatriculation: @Model.NumeroImmatriculation</p>
    <p>Marque: @Model.Marque</p>
    <p>Modèle: @Model.Modele</p>
    <p>Année: @Model.Annee</p>
    <p>Couleur: @Model.Couleur</p>
    <p>Kilométrage: @Model.Kilometrage</p>
    <p>Valeur estimé: @Model.ValeurEstime</p>
    @foreach(var note in Model.Notes)
    {
        <p>Note : @note.Texte</p>
    }
    @foreach(var location in Model.Locations)
    {
        <p>Location : @location.Statut</p>
    }
}